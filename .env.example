# External Provider URLs and Keys are intentionally blank in this public template.
# Fill them only in the ignored local .env or a deployment secret store.
LEARNINGLOOP_VIBE_BASE_URL=
LEARNINGLOOP_VIBE_FLASH_KEY=
LEARNINGLOOP_VIBE_PRO_KEY=
LEARNINGLOOP_VIBE_FLASH_MODEL=provider-flash-model
LEARNINGLOOP_VIBE_PRO_MODEL=provider-pro-model

LEARNINGLOOP_KCNE_BASE_URL=
LEARNINGLOOP_KCNE_FLASH_KEY=
LEARNINGLOOP_KCNE_PRO_KEY=
LEARNINGLOOP_KCNE_FLASH_MODEL=provider-flash-model
LEARNINGLOOP_KCNE_PRO_MODEL=provider-pro-model

# The primary and fallback endpoints must be supplied locally when live mode is enabled.
LEARNINGLOOP_DEEPSEEK_BASE_URL=
LEARNINGLOOP_DEEPSEEK_API_KEY=
LEARNINGLOOP_DEEPSEEK_FLASH_MODEL=provider-flash-model
LEARNINGLOOP_DEEPSEEK_PRO_MODEL=provider-pro-model
LEARNINGLOOP_ENABLE_RELAY_FALLBACK=false

LEARNINGLOOP_DATA_DIR=./data
LEARNINGLOOP_SKILLS_DIR=./skills
LEARNINGLOOP_HOST=127.0.0.1
LEARNINGLOOP_PORT=8765
LEARNINGLOOP_ENABLE_REAL_MODELS=false
LEARNINGLOOP_AUTH_ENABLED=false
LEARNINGLOOP_AUTH_COOKIE_SECURE=true
LEARNINGLOOP_AUTH_SESSION_HOURS=168
LEARNINGLOOP_DOMAIN=learn.example.com
LEARNINGLOOP_OTEL_ENABLED=false
LEARNINGLOOP_OTEL_SERVICE_NAME=learningloop
LEARNINGLOOP_OTEL_EXPORTER_ENDPOINT=
LEARNINGLOOP_SMTP_HOST=
LEARNINGLOOP_SMTP_PORT=465
LEARNINGLOOP_SMTP_USERNAME=
LEARNINGLOOP_SMTP_PASSWORD=
LEARNINGLOOP_SMTP_USE_TLS=false
LEARNINGLOOP_SMTP_USE_SSL=true
LEARNINGLOOP_SMTP_SENDER=
LEARNINGLOOP_NOTIFICATION_TIMEZONE=Asia/Shanghai
LEARNINGLOOP_NOTIFICATION_MORNING_TIME=08:30
LEARNINGLOOP_NOTIFICATION_EVENING_TIME=20:30
LEARNINGLOOP_NOTIFICATION_SCHEDULER_ENABLED=true
LEARNINGLOOP_NOTIFICATION_POLL_SECONDS=30
